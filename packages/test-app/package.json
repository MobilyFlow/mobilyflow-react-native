{
  "name": "test-app",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device \"$EXPO_IOS_RUN_DEVICE\"",
    "prebuild": "cd ../mobilyflow-react-native-sdk && yarn build && cd ../test-app && yarn expo prebuild --clean",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\""
  },
  "dependencies": {
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-native-vector-icons/material-icons": "^13.1.4",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@react-stateless-dialog/core": "^0.4.0-beta5",
    "@react-stateless-dialog/native": "^0.4.0-beta5",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "luxon": "^3.7.2",
    "mobilyflow-react-native-sdk": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "private": true
}
